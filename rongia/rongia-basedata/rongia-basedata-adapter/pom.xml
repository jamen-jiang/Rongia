<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rongia</groupId>
        <artifactId>rongia-basedata</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>rongia-basedata-adapter</artifactId>

    <dependencies>
        <!-- 本上下文应用层：入站适配器（REST/定时任务等）调用应用层用例 -->
        <dependency>
            <groupId>com.rongia</groupId>
            <artifactId>rongia-basedata-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 本上下文基础设施层：入站适配器可直接使用仓储实现与技术组件 -->
        <dependency>
            <groupId>com.rongia</groupId>
            <artifactId>rongia-basedata-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Web 入站适配器所需能力由本模块自行显式声明，不再经聚合模块传递 -->
        <!-- Spring Boot Web：内嵌容器 + Spring MVC（传递 jakarta.servlet-api） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Boot AspectJ：AOP 切面支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- Knife4j：OpenAPI3 增强 UI（传递 springdoc + swagger-models） -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>