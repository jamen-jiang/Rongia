<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rongia</groupId>
        <artifactId>rongia-kernel</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>rongia-kernel-domain</artifactId>
    <name>rongia-kernel-domain</name>
    <description>DDD 领域内核：聚合根 / 实体 / 值对象 / 领域事件 / 仓储接口 / 领域枚举与层级工具，由各业务上下文 domain 层与 shared-infrastructure 直接依赖。</description>

    <!-- ==========================================================
         定位：整个应用只有这一份「领域模型构件」，是各限界上下文共用的
         基类与接口；kernel 之名强调它必须极小、稳定，改动需与各上下文协商。

         归属：作为顶层 rongia-kernel 聚合下的子模块，与
         rongia-kernel-application / rongia-kernel-infrastructure 平级。
         通用原语（BaseEnum / EnumUtils 等）放在与 rongia-kernel 同级的
         rongia-shared 模块，本模块直接依赖它。

         依赖方向 rongia-shared <- rongia-kernel-domain <- 业务 domain，无环。

         保持单层模块（不再拆聚合 + 子模块）：目前只有一类构件，多加一层
         pom 只会拉长继承链。

         包名 com.rongia.kernel.domain.*，与模块名前缀一致。
         ========================================================== -->
    <dependencies>
        <!-- 通用原语：BaseEnum / DomainException / 枚举工具 -->
        <dependency>
            <groupId>com.rongia</groupId>
            <artifactId>rongia-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Jakarta Persistence API 提供 JPA 标准注解，供领域构件编译期使用。-->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <!-- Hibernate 专有注解（@SQLRestriction 等）-->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
    </dependencies>
</project>