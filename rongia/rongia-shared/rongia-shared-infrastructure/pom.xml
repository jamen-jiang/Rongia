<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rongia</groupId>
        <artifactId>rongia-shared</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>rongia-shared-infrastructure</artifactId>
    <name>rongia-shared-infrastructure</name>
    <description>共享基础设施：集中承载各业务上下文 infrastructure 层共用的技术组件与框架实现</description>

    <!-- ==========================================================
         各上下文（basedata / inventory / production / sales）的 infrastructure
         只需依赖本模块一行，即可获得全部技术组件，无需各自重复声明。
         版本统一由根 pom 的 dependencyManagement 管理，此处一律不写 <version>。
         ========================================================== -->
    <dependencies>
        <!-- 共享领域层：Entity / AggregateRoot / DomainEvent 等 DDD 构件 -->
        <dependency>
            <groupId>com.rongia</groupId>
            <artifactId>rongia-shared-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 共享应用层：TokenIssuer / CurrentUser 等跨上下文端口在此定义，本层实现它们 -->
        <dependency>
            <groupId>com.rongia</groupId>
            <artifactId>rongia-shared-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ================= 持久化：JPA / MyBatis-Plus / SQL Server / Flyway ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- SQL Server 驱动：仅运行时加载，代码中不直接引用 -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 数据库版本迁移 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
        </dependency>
        <!-- MyBatis-Plus：Spring Boot 4 专属 Starter（Flowable 自带的 MyBatis 由它统一提供） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 分页插件依赖的 JSqlParser -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- ================= 缓存 / 分布式锁：Redis / Redisson ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-cache</artifactId>
        </dependency>

        <!-- ================= 安全：Spring Security + JWT ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Servlet API：JwtAuthenticationFilter / HttpContextHolder / WebUtils 需要 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Spring MVC：SecurityConfig / PermitAllUrlScanner 需要 RequestMappingHandlerMapping -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Swagger 模型（Jakarta 版）：HttpContextHolder 使用 @Operation / @Tag -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models-jakarta</artifactId>
        </dependency>

        <!-- ================= 序列化：Jackson 3（Spring Boot 4 默认） ================= -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson</artifactId>
        </dependency>

        <!-- ================= 文件与报表：Apache POI / FTP ================= -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
        </dependency>

        <!-- ================= 邮件 ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ================= 后台任务调度：JobRunr ================= -->
        <dependency>
            <groupId>org.jobrunr</groupId>
            <artifactId>jobrunr</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jobrunr</groupId>
            <artifactId>jobrunr-spring-boot-4-starter</artifactId>
        </dependency>

        <!-- ================= 工作流引擎：Flowable ================= -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>8.0.0</version>
            <exclusions>
                <!-- 排除 Flowable 自带的 MyBatis，由下方 MyBatis-Plus 统一提供 -->
                <exclusion>
                    <groupId>org.mybatis</groupId>
                    <artifactId>mybatis</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mybatis</groupId>
                    <artifactId>mybatis-spring</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- WebSocket + STOMP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        
        <!-- ================= User-Agent 解析 ================= -->
        <dependency>
            <groupId>nl.basjes.parse.useragent</groupId>
            <artifactId>yauaa</artifactId>
        </dependency>

        <!-- ================= AOP ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
    </dependencies>
</project>
